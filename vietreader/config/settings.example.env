VIETREADER_DATABASE_URL=sqlite:///./vietreader.db
# Local/test: tự tạo schema cho tiện. Production phải đặt false và chạy Alembic khi khởi động.
VIETREADER_AUTO_CREATE_SCHEMA=true
# Production trên Render đặt true để không bao giờ rơi về SQLite trên filesystem tạm.
VIETREADER_REQUIRE_POSTGRES=false

# Tên hiển thị trong lời chào và các màn hình trống.
VIETREADER_READER_NAME=Ngân Giang

VIETREADER_LLM_PROVIDER=anthropic
VIETREADER_LLM_MODEL=claude-haiku-4-5-20251001
VIETREADER_LLM_API_KEY=
VIETREADER_LLM_PROMPT_VERSION=v1
VIETREADER_LLM_TEMPERATURE=0.0
VIETREADER_LLM_BATCH_SIZE=40
VIETREADER_LLM_MAX_RETRIES=2

VIETREADER_FETCH_USER_AGENT=VietReaderBot/0.1 (personal reading assistant)
VIETREADER_FETCH_TIMEOUT_SECONDS=15.0
VIETREADER_FETCH_DELAY_SECONDS=1.0
VIETREADER_FETCH_MAX_RETRIES=2
VIETREADER_FETCH_VERIFY_TLS=true
# Chỉ bật khi chạy trong một mạng tin cậy và thực sự cần đọc URL nội bộ.
VIETREADER_FETCH_ALLOW_PRIVATE_NETWORKS=false

# Local có thể để false. Khi mở app ra Internet, bật true và đặt cả username/password.
VIETREADER_REQUIRE_AUTH=false
VIETREADER_AUTH_USERNAME=
VIETREADER_AUTH_PASSWORD=

# Script khởi động container đọc biến này; 1 = seed các entry mẫu chưa tồn tại.
VIETREADER_SEED_ON_START=0

VIETREADER_LOG_LEVEL=INFO
