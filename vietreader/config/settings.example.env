VIETREADER_DATABASE_URL=sqlite:///./vietreader.db

# Tên hiển thị trong lời chào và các màn hình trống.
VIETREADER_READER_NAME=Ngân Giang

VIETREADER_LLM_PROVIDER=anthropic
VIETREADER_LLM_MODEL=claude-haiku-4-5-20251001
VIETREADER_LLM_API_KEY=
VIETREADER_LLM_PROMPT_VERSION=v1
VIETREADER_LLM_TEMPERATURE=0.0
VIETREADER_LLM_BATCH_SIZE=40
VIETREADER_LLM_MAX_RETRIES=2

VIETREADER_FETCH_USER_AGENT=VietReaderBot/0.1 (personal reading assistant)
VIETREADER_FETCH_TIMEOUT_SECONDS=15.0
VIETREADER_FETCH_DELAY_SECONDS=1.0
VIETREADER_FETCH_MAX_RETRIES=2

VIETREADER_LOG_LEVEL=INFO
